# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_REGION=us-west-004
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# B2_REGION=us-west-004
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-sports-highlights

# AI moment summaries (Anthropic Claude) — optional but recommended.
# Without it the pipeline still detects, clips, and annotates; moments get a
# templated fallback description. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Roboflow detection (optional). Pre-trained COCO models run locally with NO
# key. Set this only to use sport-specific Roboflow Universe models or hosted
# serverless inference. Free tier: https://app.roboflow.com/
ROBOFLOW_API_KEY=

# Class-name → heuristic-role mapping (optional, comma-separated, case-
# insensitive). The keyless COCO default emits "person"/"sports ball", so the
# defaults below reproduce stock behavior. Roboflow Universe sport-specific
# models usually emit custom labels — override these so the person/ball
# highlight heuristic keeps firing instead of collapsing to motion-only, e.g.
# for a basketball model:
#   DETECTION_MODEL=basketball-players-xxxx/3
#   DETECTION_PERSON_CLASSES=player
#   DETECTION_BALL_CLASSES=basketball
# DETECTION_PERSON_CLASSES=person
# DETECTION_BALL_CLASSES=sports ball

# Optional: serve B2 objects from a public/CDN base URL instead of presigned
# GET URLs. Leave unset to use presigned URLs (the default). If set, it should
# be the bucket's public base, e.g. https://<bucket>.s3.us-west-004.backblazeb2.com
# B2_PUBLIC_URL=

# Pipeline knobs (optional — sensible defaults shown).
# DETECTION_MODEL=rfdetr-base
# ANALYZE_STRIDE=3
# MAX_MOMENTS=8
# SUMMARY_MODEL=claude-haiku-4-5
